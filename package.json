{
  "name": "variant-review-portal",
  "version": "0.1.0",
  "description": "Turn the images jb2export batch renders from a VCF of structural or small variants into a static review portal: one card per record, the sample and its control in one image, a verdict, and a link back into JBrowse",
  "keywords": [
    "genomics",
    "structural-variants",
    "snv",
    "vcf",
    "jbrowse"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cmdcolin/variant-review-portal.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "variant-review-portal": "./bin/make-portal.mjs",
    "variant-review-slice": "./bin/slice-reads.mjs",
    "variant-review-trio-sites": "./bin/trio-sites.mjs"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:browser": "node test/browser.mjs",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@gmod/vcf": "^7.4.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "puppeteer": "^25.18.1",
    "tsrs": "7.1.0-beta.tsrs3"
  }
}
